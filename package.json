{
  "name": "cowneck",
  "version": "1.0.0",
  "description": "Interactive games, web applications, and essays by Jimmy Orr.",
  "author": "Jimmy Orr",
  "scripts": {
    "sync:metadata": "python3 scripts/sync-games-metadata.py",
    "build:og": "python3 scripts/generate-og-image.py",
    "lint": "eslint . --max-warnings=0",
    "test:unit": "node --test games/high-society/logic.test.js games/wizard.test.js games/donut-chef.test.js",
    "test:e2e": "playwright test",
    "test": "npm run lint && npm run test:unit && npm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "eslint": "^10.14.0",
    "eslint-plugin-html": "^8.2.1",
    "globals": "^17.14.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
